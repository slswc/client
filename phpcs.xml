<?xml version="1.0"?>
<ruleset name="SLSWC Client">
	<description>Coding standards for SLSWC Client</description>

	<file>./src</file>

	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="parallel" value="75"/>

	<rule ref="WordPress-Core">
		<!-- Use spaces instead of tabs -->
		<exclude name="WordPress.WhiteSpace.ControlStructureSpacing.NoSpaceBetweenStructureColon"/>
		<exclude name="Generic.WhiteSpace.DisallowSpaceIndent.SpacesUsed"/>
	</rule>

	<!-- Enforce space-based indentation -->
	<rule ref="Generic.WhiteSpace.DisallowTabIndent"/>
	<rule ref="Squiz.WhiteSpace.SuperfluousWhitespace"/>

	<!-- Allow snake_case method names (WordPress convention) -->
	<rule ref="PSR1.Methods.CamelCapsMethodName.NotCamelCaps">
		<severity>0</severity>
	</rule>

	<!-- Allow class files that don't match class name -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<severity>0</severity>
	</rule>
</ruleset>
